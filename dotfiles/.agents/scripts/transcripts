#!/usr/bin/env python3
"""Read your own Claude Code session transcripts so agents stop re-writing jq for it.

  transcripts sessions [--days N] [--project PATH]
  transcripts turns    [--days N] [--project PATH] [--session ID] [--grep RE]
                       [--corrections] [--context CHARS] [--json]

Scope defaults to the project of the current directory. `--project all` reads every
project, which you only do when the human asked for it.

The JSONL layout is Claude Code's internal format and shifts between versions, so every
field read here is optional: a line this script can't parse is skipped, never fatal.
"""

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path

PROJECTS = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"

# Harness noise that rides in user-role messages but was never typed by the human.
NOISE_BLOCK = re.compile(
    r"<(system-reminder|local-command-stdout|local-command-stderr|local-command-caveat|"
    r"command-message)>.*?</\1>",
    re.S,
)
COMMAND_NAME = re.compile(r"<command-name>(.*?)</command-name>", re.S)
COMMAND_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)

# Heuristic, not a classifier: it over-matches ("no problem") and misses polite
# corrections. It narrows the read, the reader still judges every hit.
CORRECTION = re.compile(
    r"(\b(no|nope|stop|don'?t|do not|never|wrong|incorrect|instead|actually|undo|revert|"
    r"again|rather|why did you|why are you|i said|i told you|i asked|not what|"
    r"that'?s not|you forgot|you missed|you didn'?t|should have|shouldn'?t)\b"
    r"|\[Request interrupted by user)",
    re.I,
)


def project_dirs(project):
    if not PROJECTS.is_dir():
        sys.exit(f"transcripts: no {PROJECTS}")
    if project == "all":
        return sorted(p for p in PROJECTS.iterdir() if p.is_dir())
    path = os.path.realpath(project or os.getcwd())
    slug = PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", path)
    if slug.is_dir():
        return [slug]
    # Long paths get truncated and hashed, so fall back to matching the recorded cwd.
    for d in PROJECTS.iterdir():
        for f in sorted(d.glob("*.jsonl"))[:3]:
            for rec in records(f, limit=20):
                if rec.get("cwd") == path:
                    return [d]
    sys.exit(f"transcripts: no transcripts for {path} under {PROJECTS}")


def session_files(dirs, days, session):
    cutoff = time.time() - days * 86400
    files = []
    for d in dirs:
        # Top-level files only: subagent transcripts live under <session>/subagents/
        # and never hold the human's words.
        for f in d.glob("*.jsonl"):
            if session and not f.stem.startswith(session):
                continue
            if f.stat().st_mtime >= cutoff:
                files.append(f)
    return sorted(files, key=lambda f: f.stat().st_mtime)


def records(path, limit=None):
    with open(path, errors="replace") as fh:
        for i, line in enumerate(fh):
            if limit is not None and i >= limit:
                return
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict):
                yield rec


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def human_text(rec):
    """The human's own words in a user record, or None for tool results and harness noise."""
    if rec.get("type") != "user" or rec.get("isMeta") or rec.get("isSidechain"):
        return None
    if rec.get("isCompactSummary") or rec.get("isVisibleInTranscriptOnly"):
        return None
    if (rec.get("origin") or {}).get("kind") not in (None, "human"):
        return None
    raw = text_of((rec.get("message") or {}).get("content"))
    name, args = COMMAND_NAME.search(raw), COMMAND_ARGS.search(raw)
    raw = NOISE_BLOCK.sub("", raw)
    if name:
        raw = f"{name.group(1).strip()} {args.group(1).strip() if args else ''}".strip()
    raw = raw.strip()
    return raw or None


def assistant_text(rec):
    if rec.get("type") != "assistant" or rec.get("isSidechain"):
        return None
    return text_of((rec.get("message") or {}).get("content")).strip() or None


def iter_turns(files, days):
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - days * 86400))
    for f in files:
        last_reply = ""
        for rec in records(f):
            reply = assistant_text(rec)
            if reply:
                last_reply = reply
                continue
            text = human_text(rec)
            if text is None:
                continue
            if rec.get("timestamp", "9") < cutoff:
                last_reply = ""
                continue
            yield {
                "session": f.stem,
                "time": rec.get("timestamp", ""),
                "branch": rec.get("gitBranch", ""),
                "text": text,
                "after": last_reply,
            }
            last_reply = ""


def clip(s, n, tail=False):
    if n <= 0:
        return ""
    s = " ".join(s.split())
    if len(s) <= n:
        return s
    return "…" + s[-n:] if tail else s[:n] + "…"


def cmd_sessions(args):
    rows = []
    for f in session_files(project_dirs(args.project), args.days, None):
        first, count, branch = "", 0, ""
        for rec in records(f):
            text = human_text(rec)
            if text:
                count += 1
                first = first or text
                branch = branch or rec.get("gitBranch", "")
        if count:
            rows.append(
                {
                    "session": f.stem,
                    "project": f.parent.name,
                    "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime)),
                    "branch": branch,
                    "human_turns": count,
                    "first_prompt": clip(first, 160),
                }
            )
    if args.json:
        for r in rows:
            print(json.dumps(r))
        return
    for r in rows:
        print(f"{r['modified']}  {r['session']}  [{r['branch']}] {r['human_turns']} turns  {r['first_prompt']}")


def cmd_turns(args):
    grep = re.compile(args.grep, re.I) if args.grep else None
    files = session_files(project_dirs(args.project), args.days, args.session)
    for t in iter_turns(files, args.days):
        if grep and not (grep.search(t["text"]) or grep.search(t["after"])):
            continue
        if args.corrections and not CORRECTION.search(t["text"]):
            continue
        if args.json:
            print(json.dumps({**t, "after": clip(t["after"], args.context, tail=True)}))
            continue
        print(f"## {t['session'][:8]} {t['time'][:16]} [{t['branch']}]")
        if args.context and t["after"]:
            print(f"   agent: {clip(t['after'], args.context, tail=True)}")
        print(f"   human: {t['text']}\n")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("sessions", "turns"):
        s = sub.add_parser(name)
        s.add_argument("--days", type=float, default=7)
        s.add_argument("--project", help="project path (default: cwd), or 'all'")
        s.add_argument("--json", action="store_true", help="one JSON object per line")
    t = sub.choices["turns"]
    t.add_argument("--session", help="session id or prefix")
    t.add_argument("--grep", help="regex over the human turn and the agent text before it")
    t.add_argument("--corrections", action="store_true", help="only turns that look like corrections")
    t.add_argument("--context", type=int, default=300, help="chars of the agent's preceding reply")
    args = p.parse_args()
    {"sessions": cmd_sessions, "turns": cmd_turns}[args.cmd](args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)

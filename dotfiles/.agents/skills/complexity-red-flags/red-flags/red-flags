#!/usr/bin/env bash
# red-flags — deterministic candidate-flagger for PoSD-style complexity smells.
# High recall, no verdicts. The /complexity-red-flags audit skill is the judge.
#
# Usage:
#   red-flags [PATH]                    Scan PATH (default: cwd) for .ts/.tsx
#   red-flags [PATH] --diff <git-ref>   Scan only files changed since <git-ref>
#   red-flags [PATH] --format json      JSON output (default)
#   red-flags [PATH] --format text      Human-readable digest
#
# Output schema (json):
#   { summary: { totalFindings, byFlag, topFiles[] }, findings: [{flag,file,line,message,metadata}] }
#
# Each finding's `severity` is always "candidate" — the script does not decide.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RULES_DIR="$SCRIPT_DIR/rules"

# Tunables. Threshold rationale:
# - SHALLOW_RATIO_X10: ratio = exports/body_lines. > 0.3 means roughly one
#   export per ≤3 lines of implementation. Stored * 10 for integer math in bash.
# - SHALLOW_MIN_BODY: avoids flagging trivial single-export config files.
# - WIDE_MIN_EXPORTS: barrels above this surface are noisy to import from.
SHALLOW_RATIO_X10=3
SHALLOW_MIN_BODY=3
SHALLOW_MIN_EXPORTS=2
WIDE_MIN_EXPORTS=10

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
}

# -------- Arg parse --------

TARGET=""
DIFF_REF=""
FORMAT="json"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --diff)   DIFF_REF="${2:?--diff needs a ref}"; shift 2 ;;
    --format) FORMAT="${2:?--format needs a value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; TARGET="${1:-}"; break ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *)  TARGET="$1"; shift ;;
  esac
done
TARGET="${TARGET:-.}"
[[ -d "$TARGET" || -f "$TARGET" ]] || { echo "no such path: $TARGET" >&2; exit 2; }
TARGET_ABS="$(cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET")"

# All file paths in output are relative to TARGET_ABS — invoking detectors
# from inside the target dir keeps ast-grep/rg outputs already-relative.
cd "$TARGET_ABS"

# -------- File collection --------

collect_files() {
  if [[ -n "$DIFF_REF" ]]; then
    # In an agent loop most changes are uncommitted, so we union three sets:
    # (1) committed diff vs ref, (2) working-tree modified, (3) untracked.
    # `sort -u` dedupes; the `[[ -f ]]` guard drops deleted entries.
    {
      git diff --name-only --diff-filter=ACMR "$DIFF_REF" -- '*.ts' '*.tsx' 2>/dev/null
      git ls-files --modified --others --exclude-standard -- '*.ts' '*.tsx' 2>/dev/null
    } | sort -u | while read -r f; do [[ -f "$f" ]] && echo "$f"; done
  else
    rg --files --type-add 'ts:*.ts' --type-add 'ts:*.tsx' --type ts 2>/dev/null || true
  fi
}

# -------- Detectors --------
# Each emits NDJSON to stdout. One JSON object per finding, no trailing comma.

# ast-grep based: pass-through, empty-catch, catch-rethrow.
# ast-grep returns 0-based line numbers; we adjust to 1-based.
run_ast_grep_rule() {
  local rule_file="$1" flag="$2" message="$3"; shift 3
  local files=("$@")
  [[ ${#files[@]} -eq 0 ]] && return 0
  ast-grep scan --rule "$rule_file" --json=compact "${files[@]}" 2>/dev/null \
    | jq -c --arg flag "$flag" --arg msg "$message" '
        .[] | {
          flag: $flag,
          severity: "candidate",
          file: .file,
          line: (.range.start.line + 1),
          message: $msg,
          metadata: {}
        }
      '
}

detect_pass_through_method() {
  run_ast_grep_rule "$RULES_DIR/pass-through-method.yml" \
    "passThroughMethod" \
    "method body is a single delegating call" \
    "$@"
}

detect_empty_catch() {
  run_ast_grep_rule "$RULES_DIR/empty-catch.yml" \
    "emptyCatch" \
    "catch body has no executable statement" \
    "$@"
}

detect_catch_rethrow() {
  run_ast_grep_rule "$RULES_DIR/catch-rethrow.yml" \
    "catchRethrow" \
    "catch body is a pure rethrow" \
    "$@"
}

# Counts top-level exports against non-blank/non-comment/non-import body lines.
# Reports at line 1 because the smell is module-wide.
detect_shallow_module() {
  local f exports body ratio_x10
  for f in "$@"; do
    exports=$(rg -c '^export\s' -- "$f" 2>/dev/null || echo 0)
    body=$(rg -c -v '^\s*(//|/\*|\*|import\s|$)' -- "$f" 2>/dev/null || echo 0)
    if (( body >= SHALLOW_MIN_BODY && exports >= SHALLOW_MIN_EXPORTS )); then
      ratio_x10=$(( exports * 10 / body ))
      if (( ratio_x10 > SHALLOW_RATIO_X10 )); then
        jq -nc --arg f "$f" --argjson e "$exports" --argjson b "$body" '
          {
            flag: "shallowModule",
            severity: "candidate",
            file: $f,
            line: 1,
            message: ("\($e) exports / \($b) body lines — interface heavy relative to implementation"),
            metadata: { exports: $e, bodyLines: $b }
          }'
      fi
    fi
  done
}

# Class/interface/type names ending in generic suffixes (PoSD ch.14).
# Service is intentionally excluded — too prevalent in legit code to flag.
detect_generic_naming() {
  local f
  local pattern='\b(class|interface|type)\s+\w*(Manager|Helper|Wrapper|Container|Holder|Utils|Util|Misc|Common|Processor|Handler)\b'
  for f in "$@"; do
    rg --line-number --no-heading --pcre2 -e "$pattern" -- "$f" 2>/dev/null \
      | while IFS=: read -r line _; do
          jq -nc --arg f "$f" --argjson l "$line" '
            {
              flag: "genericNaming",
              severity: "candidate",
              file: $f,
              line: $l,
              message: "name uses a generic suffix (Manager/Helper/Utils/...)",
              metadata: {}
            }'
        done
  done
}

# `as any`, @ts-ignore, @ts-expect-error.
# Each is a tactical-programming smell — the LLM judges if the cast is unavoidable.
detect_ts_escape_hatches() {
  local f
  for f in "$@"; do
    rg --line-number --no-heading -e '\bas\s+any\b|@ts-ignore|@ts-expect-error' -- "$f" 2>/dev/null \
      | while IFS=: read -r line _; do
          jq -nc --arg f "$f" --argjson l "$line" '
            {
              flag: "tsEscapeHatch",
              severity: "candidate",
              file: $f,
              line: $l,
              message: "TS escape hatch (`as any` / `@ts-ignore` / `@ts-expect-error`)",
              metadata: {}
            }'
        done
  done
}

# Files exporting more than WIDE_MIN_EXPORTS top-level symbols. PoSD ch.4: a
# wide interface forces every importer to learn the whole surface.
detect_wide_module() {
  local f exports
  for f in "$@"; do
    exports=$(rg -c '^export\s' -- "$f" 2>/dev/null || echo 0)
    if (( exports > WIDE_MIN_EXPORTS )); then
      jq -nc --arg f "$f" --argjson e "$exports" '
        {
          flag: "wideModule",
          severity: "candidate",
          file: $f,
          line: 1,
          message: ("\($e) top-level exports — wide module surface"),
          metadata: { exports: $e }
        }'
    fi
  done
}

# -------- Orchestrate --------

mapfile -t files < <(collect_files)
if [[ ${#files[@]} -eq 0 ]]; then
  echo '{"summary":{"totalFindings":0,"byFlag":{},"topFiles":[]},"findings":[]}'
  exit 0
fi

ndjson=$(
  {
    detect_pass_through_method "${files[@]}"
    detect_empty_catch "${files[@]}"
    detect_catch_rethrow "${files[@]}"
    detect_shallow_module "${files[@]}"
    detect_generic_naming "${files[@]}"
    detect_ts_escape_hatches "${files[@]}"
    detect_wide_module "${files[@]}"
  }
)

result=$(
  if [[ -z "$ndjson" ]]; then
    echo '{"summary":{"totalFindings":0,"byFlag":{},"topFiles":[]},"findings":[]}'
  else
    echo "$ndjson" | jq -s '
      {
        summary: {
          totalFindings: length,
          byFlag: (group_by(.flag) | map({key: .[0].flag, value: length}) | from_entries),
          topFiles: (group_by(.file) | map({file: .[0].file, count: length}) | sort_by(.count) | reverse | .[0:10])
        },
        findings: sort_by(.flag, .file, .line)
      }'
  fi
)

if [[ "$FORMAT" == "json" ]]; then
  echo "$result"
else
  # Compact human digest, grouped by file. The audit skill consumes JSON; this
  # mode is for eyeballing the output during development.
  echo "$result" | jq -r '
    "Total: \(.summary.totalFindings) findings\n",
    (.summary.byFlag | to_entries | map("  \(.key): \(.value)") | join("\n")),
    "",
    "Top files:",
    (.summary.topFiles | map("  \(.count)  \(.file)") | join("\n")),
    "",
    "Findings:",
    (.findings | map("  [\(.flag)] \(.file):\(.line) — \(.message)") | join("\n"))
  '
fi
